# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-min
JWT_EXPIRES_IN_HOURS=24

# Comma-separated list of origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# Admin account created by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@12345
